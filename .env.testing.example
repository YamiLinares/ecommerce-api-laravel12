# Plantilla para las pruebas automatizadas. Copie como .env.testing (ignorado por Git).
# Use SIEMPRE una base distinta a la de desarrollo: su nombre debe terminar en "_test".
APP_ENV=testing
APP_DEBUG=false
# Genere valores propios (por ejemplo: php -r "echo base64_encode(random_bytes(32));").
APP_KEY=
JWT_SECRET=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api_laravel12_test
DB_USERNAME=ecommerce_app
DB_PASSWORD=

# Las pruebas usan un doble de Stripe y firmas generadas localmente:
# no se necesitan claves reales.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
