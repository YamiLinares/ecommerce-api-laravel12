# =============================================================================
# Ecommerce API (Laravel 12) - Plantilla de configuración
# Copie este archivo como .env y complete los valores. NUNCA suba .env a Git.
# Todos los valores de este archivo son vacíos o de ejemplo (no son credenciales).
# =============================================================================

APP_NAME="Ecommerce API"
# local | production
APP_ENV=local
# Se genera con: php artisan key:generate
APP_KEY=
# En producción SIEMPRE false (evita mostrar detalles internos).
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción use "warning" o "error".
LOG_LEVEL=debug

# --- MySQL (base de datos de desarrollo de este proyecto) ---------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api_laravel12
DB_USERNAME=ecommerce_app
# Contraseña del usuario MySQL creado para este proyecto (no use root en producción).
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Almacena la lista negra de JWT y los contadores de rate limiting.
CACHE_STORE=database

MAIL_MAILER=log

# --- JWT ----------------------------------------------------------------------
AUTH_GUARD=api
# Clave de firma HS256. Se genera con: php artisan jwt:secret
JWT_SECRET=
# Algoritmo de firma (simétrico).
JWT_ALGO=HS256
# Minutos de validez del token de acceso.
JWT_TTL=60
# Minutos durante los cuales un token puede renovarse (14 días).
JWT_REFRESH_TTL=20160
# Necesario para invalidar tokens al cerrar sesión.
JWT_BLACKLIST_ENABLED=true

# --- Stripe (modo de pruebas) ------------------------------------------------
# Dashboard de Stripe > Developers > API keys (modo Test). Empiezan por pk_test_ / sk_test_.
STRIPE_KEY=
STRIPE_SECRET=
# Lo muestra "stripe listen" (whsec_...) o el endpoint del Dashboard > Webhooks.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Tolerancia (segundos) para la marca de tiempo de la firma del webhook.
STRIPE_WEBHOOK_TOLERANCE=300
# Solo para pruebas con stripe-mock (http://127.0.0.1:12111). Déjelo vacío normalmente.
STRIPE_API_BASE=

# --- CORS ---------------------------------------------------------------------
# Orígenes de frontends autorizados, separados por coma. Vacío = ninguno.
CORS_ALLOWED_ORIGINS=

# --- Swagger ------------------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=http://127.0.0.1:8000

# --- Usuarios de demostración (php artisan db:seed) ---------------------------
# Si deja las contraseñas vacías, el seeder genera una aleatoria y la muestra una vez.
SEED_ADMIN_EMAIL=admin@ecommerce.test
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=cliente@ecommerce.test
SEED_CUSTOMER_PASSWORD=
